  "lifetime_policy": {
    "queued": "Client lifetime expiry closes the whole Client; still-queued requests complete as Cancellation/Cancelled.",
    "active": "Active HTTP requests retain their original minimum cutoff and classify deadline expiry with received status.",
    "request_setup": "A request total cutoff or setup cutoff expiring on its own classifies Deadline."
  },
  "platform_scope": {
    "host": "Darwin arm64",
    "unverified": "A public Client stalled SYN is not certified: owned backlog1 saturates after3 successful fillers then resets immediately (ECONNRESET), not a pending SYN. No sysctls/routes/firewall were changed.",
    "layered_connect": "Twelve Runtime Connecting-slot boundary cases own an external Task/socket outside the public Client connection cap, hold it before finish_connect while a cheap public Client TCP/TLS request completes on the same one-worker Runtime, then check release/cancel/close/shutdown/original or shorter budget. These are not Client setup/lifetime tests or a stalled SYN claim."
  },
  "required_layers": {
    "public_client": 68,
    "runtime_connect_slot": 12
